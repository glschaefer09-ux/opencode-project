# Mattermost incoming webhook — URL you create in Mattermost (System Console / Integrations)
MATTERMOST_WEBHOOK_URL=

# Shared token(s) for verifying outgoing webhooks / slash commands from Mattermost.
# Comma-separated if you have more than one. Set in the Mattermost integration config.
MATTERMOST_TOKEN=

# Port for the receiver server
PORT=3000
